# =============================================
# PROTECTION DU DOSSIER BACKUPS - DoriExpress-Pro
# =============================================
# Fichier : storage/backups/.htaccess
# Rôle : Bloquer l'accès aux fichiers de sauvegarde
# =============================================

# Bloquer tous les fichiers
<Files *>
  Order Allow,Deny
  Deny from all
</Files>

# Bloquer l'indexation
Options -Indexes

# =============================================
# FIN DU FICHIER .HTACCESS
# =============================================