# =============================================
# FICHIER .HTACCESS RACINE - DoriExpress-Pro
# =============================================
# Rôle : Configuration du serveur, sécurité, réécriture d'URL
# =============================================

# =============================================
# 1. ACTIVATION DU MOTEUR DE RÉÉCRITURE
# =============================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Rediriger HTTP vers HTTPS (production)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  
  # Rediriger www vers non-www
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
  
  # Réécriture d'URL (si nécessaire)
  # RewriteRule ^boutique/([a-zA-Z0-9-]+)$ boutique.php?slug=$1 [L]
</IfModule>

# =============================================
# 2. SÉCURITÉ DES FICHIERS
# =============================================

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "\.(env|ini|log|sql|json|htaccess|htpasswd|inc|lock)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# Bloquer l'accès au fichier de configuration
<Files "config.php">
  Order Allow,Deny
  Deny from all
  </FilesMatch>
  
  # =============================================
  # 3. PROTECTION CONTRE LES ATTAQUES
  # =============================================
  
  # Protection contre les injections de fichiers
  <IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
  </IfModule>
  
  # Protection contre les attaques DDoS (limitation de taille des requêtes)
  LimitRequestBody 10240000
  
  # =============================================
  # 4. COMPRESSION GZIP
  # =============================================
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/rss+xml application/xml application/xhtml+xml
  </IfModule>
  
  # =============================================
  # 5. CACHE NAVIGATEUR
  # =============================================
  <IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - 1 an
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JavaScript - 1 mois
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Fonts - 1 an
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # HTML - 1 jour
    ExpiresByType text/html "access plus 1 day"
  </IfModule>
  
  # =============================================
  # 6. GESTION DES ERREURS
  # =============================================
  ErrorDocument 404 /404.php
  ErrorDocument 403 /403.php
  ErrorDocument 500 /500.php
  
  # =============================================
  # 7. PHP CONFIGURATION (via .htaccess)
  # =============================================
  <IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
  </IfModule>
  
  # =============================================
  # 8. BLOQUER L'ACCÈS AUX DOSSIERS SENSIBLES
  # =============================================
  RedirectMatch 403 ^/includes/.*$
  RedirectMatch 403 ^/database/.*$
  RedirectMatch 403 ^/storage/.*$
  RedirectMatch 403 ^/vendor/.*$
  
  # =============================================
  # FIN DU FICHIER .HTACCESS
  # =============================================