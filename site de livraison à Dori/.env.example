# =============================================
# ENVIRONNEMENT - DoriExpress-Pro
# =============================================
# Fichier : .env.example
# Rôle : Variables d'environnement (à copier vers .env)
# =============================================

# Application
APP_NAME="DoriExpress-Pro"
APP_ENV=production
APP_DEBUG=false
APP_URL="https://www.doriexpress.bf"
APP_TIMEZONE="Africa/Ouagadougou"

# Base de données
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="dori_express"
DB_USER="root"
DB_PASS=""

# Sécurité
APP_KEY="votre_cle_secrete_32_caracteres"
ENCRYPTION_KEY="votre_cle_chiffrement"

# Google Maps
GOOGLE_MAPS_API_KEY=""

# Orange Money
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_ID=""
ORANGE_MONEY_API_URL="https://api.orange.com/orange-money-webpay/"

# Moov Money
MOOV_MONEY_API_KEY=""
MOOV_MONEY_MERCHANT_ID=""
MOOV_MONEY_API_URL="https://api.moov.africa/moov-money/"

# WhatsApp Business
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email (SMTP)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="contact@doriexpress.bf"
MAIL_FROM_NAME="DoriExpress-Pro"

# PWA
PWA_ENABLED=true
PWA_NAME="DoriExpress-Pro"
PWA_SHORT_NAME="DoriExpress"
PWA_THEME_COLOR="#00A651"
PWA_BACKGROUND_COLOR="#FFFFFF"

# Modules
MODULE_PAIEMENT=true
MODULE_GPS=true
MODULE_CHAT=true
MODULE_IA=true
MODULE_MARKETPLACE=true
MODULE_NOTIFICATIONS=true

# =============================================
# FIN DU FICHIER .ENV.EXAMPLE
# =============================================