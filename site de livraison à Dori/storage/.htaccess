# =============================================
# PROTECTION DU DOSSIER STORAGE - DoriExpress-Pro
# =============================================
# Fichier : storage/.htaccess
# Rôle : Protéger le dossier storage contre l'accès public
# =============================================

# Interdire l'accès à tous les fichiers
<Files *>
  Order Allow,Deny
  Deny from all
</Files>

# Permettre l'accès uniquement à certains types de fichiers (si nécessaire)
# <FilesMatch "\.(log|txt)$">
  # Order Allow,Deny
  # Deny from all
  # </FilesMatch>

# Désactiver l'indexation des dossiers
Options -Indexes

# Désactiver le suivi des liens symboliques
Options -FollowSymLinks

# Empêcher l'exécution de PHP
<FilesMatch "\.(php|phtml|php3|php4|php5|phps)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>

# =============================================
# FIN DU FICHIER .HTACCESS
# =============================================